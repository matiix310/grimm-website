{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun-types", "node"]
  },
  "include": ["src/**/*"]
}
